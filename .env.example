# Pooled Neon endpoint (host contains "-pooler"); used by the app at runtime.
DATABASE_URL=
# Direct/unpooled Neon endpoint (same database, host WITHOUT "-pooler"); used by
# `npm run db:migrate` (drizzle.config.ts prefers DATABASE_URL_UNPOOLED). Point
# both at the SAME database. On Vercel the Neon integration injects both.
DATABASE_URL_UNPOOLED=
ADMIN_TOKEN=
CRON_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
# Vercel Blob read-write token; when set, app-variation bundles are stored in Blob instead of the local .bundles/ dir.
# This is per-environment: each Vercel environment gets its own store token (prod store for Production,
# a separate non-prod store for Preview/Development). See docs/deploy.md > "Per-environment Blob store".
BLOB_READ_WRITE_TOKEN=
# Optional. Enables the "Feedback" link in the voter rail, which posts to
# Linear as a Triage issue. Create a personal API key at
# linear.app/settings/account/security and paste it here (unprefixed, no
# "Bearer"). Leave blank to disable the feature entirely — it no-ops cleanly
# (503) without crashing anything.
LINEAR_API_KEY=
# Optional. To route feedback to your OWN Linear team, set LINEAR_TEAM_ID; the
# issue lands in that team using Linear's own defaults for state/project/label.
# The remaining three are independent refinements WITHIN your team — set any of
# them only if you want a specific project, workflow state, or label. When
# LINEAR_TEAM_ID is left unset, all four default to the maintainer's workspace;
# when you point it at your own team, the maintainer's project/state/label
# defaults are dropped (they'd be rejected cross-workspace), so set your own if
# you need them.
# LINEAR_TEAM_ID=
# LINEAR_PROJECT_ID=
# LINEAR_TRIAGE_STATE_ID=
# LINEAR_FEEDBACK_LABEL_ID=  # label applied to each feedback issue (default: "Feedback")
# Optional. The feedback form always posts to a single canonical endpoint so
# every install's feedback reaches the maintainer's Linear by default — you
# don't need to set anything for that to work. Set this only if you want
# feedback from YOUR install to go to your OWN Linear instead: point it at
# your own deployment's /api/feedback URL (and set LINEAR_API_KEY above).
# NEXT_PUBLIC_FEEDBACK_ENDPOINT=
