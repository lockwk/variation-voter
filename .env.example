# Neon pooled connection string, e.g. postgres://user:pass@host/db
DATABASE_URL=
# Long random secret that authorizes the CLI/admin API to create, close,
# and delete voters. Generate one with: openssl rand -hex 24
ADMIN_TOKEN=
# Long random secret Vercel Cron sends on the daily cleanup run. Generate
# one with: openssl rand -hex 24
CRON_SECRET=
# The real, publicly reachable URL of this deployed instance. Used to build
# share links — if this is wrong or left as localhost in production, every
# shareUrl the app returns will be unusable to anyone but you.
PUBLIC_BASE_URL=http://localhost:3000
